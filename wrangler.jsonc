{
	"name": "vdocs",
	"main": "src/worker.ts",
	"compatibility_date": "2026-11-01",
	// The address of docs.config.json. Cloudflare makes the DNS record and the certificate.
	"routes": [{ "pattern": "verticaldocs.dev", "custom_domain": true }],
	"assets": {
		"directory": "dist",
		"binding": "ASSETS",
		// An address with no page answers 404 with dist/404.html.
		"not_found_handling": "404-page",
		// The Worker answers pages and /mcp. Hashed files are served without it.
		"run_worker_first": ["/*", "!/_astro/*"]
	}
}
