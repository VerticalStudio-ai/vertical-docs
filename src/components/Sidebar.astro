---
import type { NavItem } from "../core/nav.ts";

interface Props {
	items: NavItem[];
	current: string;
}

const { items, current } = Astro.props;
---

<ul>
	{
		items.map((item) => {
			const link = (
				<a href={item.href} aria-current={item.href === current ? "page" : undefined}>
					{item.title}
				</a>
			);
			return (
				<li>
					{item.children.length === 0 ? (
						link
					) : (
						<details open={current.startsWith(item.href)}>
							<summary>{link}</summary>
							<Astro.self items={item.children} current={current} />
						</details>
					)}
				</li>
			);
		})
	}
</ul>
