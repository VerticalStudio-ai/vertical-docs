<button type="button" class="find" aria-label="Search">
	<svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
		<path d="M7 1.5a5.5 5.5 0 1 0 3.4 9.8l3.3 3.3 1-1-3.3-3.3A5.5 5.5 0 0 0 7 1.5M7 3a4 4 0 1 1 0 8 4 4 0 0 1 0-8"></path>
	</svg>
	<span>Search</span>
	<kbd>/</kbd>
</button>
<dialog aria-label="Search" closedby="any">
	<input aria-label="Search the docs" placeholder="Search the docs" autocomplete="off" />
	<p role="status"></p>
	<ul></ul>
	<form method="dialog">
		<button type="submit" aria-label="Close the search">
			<svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
				<path d="m3.5 2.4 4.5 4.5 4.5-4.5 1.1 1.1L9.1 8l4.5 4.5-1.1 1.1L8 9.1l-4.5 4.5-1.1-1.1L6.9 8 2.4 3.5z"></path>
			</svg>
		</button>
	</form>
</dialog>

<script>
	import type { search } from "../core/search.ts";

	const dialog = document.querySelector("dialog");
	const input = dialog?.querySelector("input");
	const list = dialog?.querySelector("ul");
	const status = dialog?.querySelector("p");

	const show = ({ data }: MessageEvent<ReturnType<ReturnType<typeof search>>>) => {
		list?.replaceChildren(
			...data.map(({ url, title, heading, snippet }) => {
				const item = document.createElement("li");
				const link = item.appendChild(document.createElement("a"));
				const text = document.createElement("small");
				text.textContent = snippet;
				link.href = url;
				link.append(heading ? `${title} › ${heading}` : title, text);
				return item;
			}),
		);
		if (status) {
			status.textContent = data.length > 0 || !input?.value.trim() ? "" : "No results.";
		}
	};

	// The worker holds the search code and the index. The browser downloads both the first time the dialog opens.
	let worker: Worker | undefined;
	const open = () => {
		worker ??= Object.assign(
			new Worker(new URL("./search-worker.ts", import.meta.url), { type: "module" }),
			{ onmessage: show },
		);
		dialog?.showModal();
	};

	document.querySelector(".find")?.addEventListener("click", open);
	document.addEventListener("keydown", (event) => {
		const shortcut = event.key === "k" && (event.metaKey || event.ctrlKey);
		if (shortcut || (event.key === "/" && !dialog?.open)) {
			event.preventDefault();
			open();
		}
	});
	input?.addEventListener("input", () => worker?.postMessage(input.value));
	// A result on the page that is already open does not reload the page, so the dialog closes itself.
	list?.addEventListener("click", () => dialog?.close());
</script>
