---
import config from "@site/docs.config.json";
import logo from "@site/public/logo.svg?raw";
import type { MarkdownHeading } from "astro";
import { markdownUrl } from "../core/llms.ts";
import { type NavItem, navigation, neighbours } from "../core/nav.ts";
import { structuredData } from "../core/seo.ts";
import mono from "../fonts/geist-mono.woff2?url";
import sans from "../fonts/geist-sans.woff2?url";
import "../styles/global.css";
import Search from "./Search.astro";
import Sidebar from "./Sidebar.astro";
import Toc from "./Toc.astro";

interface Props {
	title: string;
	description: string;
	// The address of a docs page. The 404 page has none: no address of its own, no Markdown copy and no place in the reading order.
	href?: string;
	tree: NavItem[];
	headings: MarkdownHeading[];
}

const { title, description, href, tree, headings } = Astro.props;
// The type of the configuration is read from the kit's own file, which lists no tabs.
const { tabs, items } = navigation(tree, (config as { tabs?: string[] }).tabs ?? [], href, config.home);
const { previous, next } = href ? neighbours(items, href) : {};
const home = config.home && href === "/";
// A wordmark holds the name already: the header shows the logo alone, and the name stays the link's label.
const wordmark = (config as { wordmark?: boolean }).wordmark;
// A chat opens with a prompt that names the page's Markdown copy, which the assistant can read.
const ask = (chat: string, page: string) =>
	`${chat}?q=${encodeURIComponent(`Read ${new URL(markdownUrl(page), config.url).href} so I can ask questions about it.`)}`;
---

<!doctype html>
<html lang="en" class={home ? "home" : undefined} style={`--accent: ${config.accent}`}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>{title} · {config.name}</title>
		<meta name="description" content={description} />
		<meta property="og:title" content={`${title} · ${config.name}`} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={new URL("/share.png", config.url).href} />
		<meta name="twitter:card" content="summary_large_image" />
		{
			href && (
				<>
					<link rel="canonical" href={new URL(href, config.url).href} />
					<meta property="og:url" content={new URL(href, config.url).href} />
					<script type="application/ld+json" set:html={structuredData(config, tree, href)} />
					<link rel="alternate" type="text/markdown" href={markdownUrl(href)} />
				</>
			)
		}
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="preload" href={sans} as="font" type="font/woff2" crossorigin />
		<link rel="preload" href={mono} as="font" type="font/woff2" crossorigin />
		{/* Applies a saved theme before the first paint, so the page does not flash. */}
		<script is:inline>
			document.documentElement.dataset.theme = localStorage.getItem("theme") ?? "";
		</script>
	</head>
	<body>
		<header class="top" id="top">
			<button type="button" class="menu" popovertarget="sidebar" aria-label="Open navigation">
				<svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
					<path d="M1 3h14v1.5H1zM1 7.25h14v1.5H1zM1 11.5h14V13H1z"></path>
				</svg>
			</button>
			<a href="/" class="brand" aria-label={wordmark ? config.name : undefined}><Fragment set:html={logo} />{!wordmark && config.name}</a>
			<Search />
			{home && items[0] && <a href={items[0].href} class="repo">Docs</a>}
			<a href={config.repo} class="repo icon">
				<svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" role="img">
					<title>GitHub</title>
					<path d="M8 0a8 8 0 0 0-2.53 15.59c.4.07.55-.17.55-.38v-1.33c-2.23.48-2.7-1.07-2.7-1.07-.36-.92-.89-1.17-.89-1.17-.73-.5.06-.49.06-.49.8.06 1.23.83 1.23.83.71 1.22 1.87.87 2.33.66.07-.52.28-.87.5-1.07-1.78-.2-3.65-.89-3.65-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 4 0c1.53-1.03 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.28.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48v2.2c0 .21.15.46.55.38A8 8 0 0 0 8 0"></path>
				</svg>
			</a>
			<button type="button" id="theme" aria-label="Switch between light and dark theme">
				<svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
					<path d="M8 1a7 7 0 1 0 0 14A7 7 0 0 0 8 1m0 1.5v11a5.5 5.5 0 0 1 0-11"></path>
				</svg>
			</button>
			{
				tabs.length > 1 && (
					<nav class="tabs" aria-label="Sections">
						{tabs.map((tab) => (
							<a href={tab.href} aria-current={tab.current ? "true" : undefined}>
								{tab.title}
							</a>
						))}
					</nav>
				)
			}
		</header>
		<div class="frame">
			<nav id="sidebar" class="sidebar" popover aria-label="Pages">
				{
					tabs.length > 1 && (
						<nav class="tabs" aria-label="Sections">
							{tabs.map((tab) => (
								<a href={tab.href} aria-current={tab.current ? "true" : undefined}>
									{tab.title}
								</a>
							))}
						</nav>
					)
				}
				<Sidebar items={items} current={href ?? ""} />
			</nav>
			<main>
				<article class="prose">
					{
						href && (
							<div class="actions">
								<button type="button" class="copy" data-page={markdownUrl(href)}>Copy page</button>
								<button type="button" class="more" popovertarget="page-menu" aria-label="More ways to read this page">
									<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
										<path d="m4 6 4 4 4-4"></path>
									</svg>
								</button>
								<div id="page-menu" popover>
									<a href={markdownUrl(href)}>View as Markdown<small>Open this page as plain text</small></a>
									<a href={ask("https://chatgpt.com/", href)}>Open in ChatGPT<small>Ask questions about this page</small></a>
									<a href={ask("https://claude.ai/new", href)}>Open in Claude<small>Ask questions about this page</small></a>
								</div>
							</div>
						)
					}
					<h1>{title}</h1>
					<p class="lead">{description}</p>
					<slot />
					{href && <p class="source"><a href={markdownUrl(href)}>View this page as Markdown</a></p>}
				</article>
				{
					href && (
						<nav class="pager" aria-label="Previous and next page">
							{
								previous && (
									<a href={previous.href} rel="prev">
										<small>Previous</small>
										{previous.title}
									</a>
								)
							}
							{
								next && (
									<a href={next.href} rel="next">
										<small>Next</small>
										{next.title}
									</a>
								)
							}
						</nav>
					)
				}
			</main>
			{headings.length > 0 && <Toc headings={headings} />}
		</div>
		<script>
			const root = document.documentElement;
			document.getElementById("theme")?.addEventListener("click", () => {
				const system = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
				const theme = (root.dataset.theme || system) === "dark" ? "light" : "dark";
				root.dataset.theme = theme;
				localStorage.setItem("theme", theme);
			});

			// Brings the current page into view in a long sidebar: on load, and when a phone opens the menu.
			const sidebar = document.getElementById("sidebar");
			const show = () => sidebar?.querySelector("[aria-current=page]")?.scrollIntoView({ block: "nearest" });
			show();
			sidebar?.addEventListener("toggle", show);

			// One listener copies for every button: the page as Markdown, or the code block under the button.
			for (const pre of document.querySelectorAll("pre")) {
				pre.insertAdjacentHTML("beforebegin", '<button type="button" class="copy">Copy</button>');
			}
			addEventListener("click", async ({ target }) => {
				if (!(target instanceof HTMLElement) || !target.matches(".copy")) return;
				const label = target.textContent;
				// A second click while the button says "Copied" would keep that word as its label.
				if (label === "Copied") return;
				const { page } = target.dataset;
				// Safari allows a clipboard write only inside the click, so the page text goes in as a promise.
				const text = page
					? fetch(page).then((response) => response.text())
					: (target.nextElementSibling?.textContent ?? "");
				await navigator.clipboard.write([new ClipboardItem({ "text/plain": text })]);
				target.textContent = "Copied";
				setTimeout(() => {
					target.textContent = label;
				}, 1500);
			});
		</script>
	</body>
</html>
