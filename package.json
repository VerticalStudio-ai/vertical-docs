{
	"name": "vdocs",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.21.0",
	"bin": {
		"vertical-docs": "lib/cli.js",
		"vdocs": "lib/cli.js"
	},
	"scripts": {
		"dev": "astro dev",
		"check": "biome ci --error-on-warnings && knip && node --test && astro check && astro build && node scripts/check-dist.ts",
		"fix": "biome check --write",
		"search": "sh -c 'node src/cli.ts search \"$@\" .' --",
		"prepack": "tsc src/cli.ts --ignoreConfig --outDir lib --rootDir src --module nodenext --types node --rewriteRelativeImportExtensions"
	},
	"dependencies": {
		"@astrojs/markdown-satteri": "^0.4.10",
		"@modelcontextprotocol/server": "^2.4.0",
		"astro": "^7.4.12",
		"github-slugger": "^2.0.0",
		"minisearch": "^7.2.0"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.12",
		"@biomejs/biome": "^2.6.8",
		"@types/node": "^22.20.5",
		"knip": "^6.45.1",
		"typescript": "^6.0.3"
	}
}
